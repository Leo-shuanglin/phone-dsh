<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- :engine's AAR already declares INTERNET (it binds the loopback origin).
         Declared here too so the demo's requirement is visible in :app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The background surface is NOT declared here, and must not be: it belongs to
      :dsh, whose library manifest declares the two services, the two receivers and
      the six permissions (FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC,
      RUN_USER_INITIATED_JOBS, WAKE_LOCK, POST_NOTIFICATIONS,
      RECEIVE_BOOT_COMPLETED). :app depends on :dsh, so the manifest merger puts
      them in the APK.

      Reading this file alone therefore shows zero services and zero receivers.
      That is a property of the source layout, not of the installed app. Read the
      merged artifact instead, under
      android/app/build/intermediates/merged_manifests/debug/processDebugManifest/,
      or, on a device, `adb shell dumpsys package com.phonedsh.probe` and look for
      TurnForegroundService / TurnJobService / TurnStopReceiver / BootReceiver.

      Declaring them again here would merge cleanly today and become a second
      source of truth tomorrow, so the app reads the merged manifest back at
      runtime instead (HostBackground.declaration) and reports the verdict on the
      runtime page's 前台服务可用性 row.
    -->

    <!--
      Backup policy (security checklist S5, plan R11):
        * android:allowBackup="false" is the primary switch: no cloud backup and
          no device-to-device transfer at all.
        * the two rule files are the second layer, required so that sensitive
          paths stay out if backup is ever enabled. API 31+ reads only
          dataExtractionRules; API 23-30 reads only fullBackupContent. Both are
          declared so neither API era silently falls back to "back everything up".
      The rule files exclude the K3 domain database and its -wal/-shm/-journal,
      the WAL workspace, the materialized worker bundle, and the SecureStore
      ciphertext directory (see their comments for the code path behind each).
    -->
    <!--
      Back gesture (`spec/ui/v1/README.md` §5 back-gesture, `platform.predictive-back`):
      the system owns the gesture and the page stack pops one level per gesture, so the
      app opts in here. `android:enableOnBackInvokedCallback` is API 33+ only (the
      platform's OnBackInvokedDispatcher); on older devices it is ignored and back
      arrives through the legacy `onBackPressed()` path, which the Activity's dispatcher
      routes to the same callback.

      The app's one back chain lives in `HostShell` (`PdshBackHandler`): drawer, then the
      top route's own inner level, then the route stack. The chain is deliberately
      *disabled* at the root route, so the platform's default (finish the Activity) runs
      there — printing `finish()` from a callback would take the task away from the
      system's predictive animation and from multi-window/recents semantics.

      This attribute only declares the intent: whether the platform carries back through
      the new path is the device's answer, which is why the 返回手势 row is measured at
      runtime rather than printed from this file.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:label="PDSH 引擎探针"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
